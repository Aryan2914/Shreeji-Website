# ==============================================================================
# SHREEJI INFOTECH — API ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

APP_NAME="Shreeji API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

# ==============================================================================
# DATABASE (MySQL)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shreeji_db
DB_USERNAME=shreeji
DB_PASSWORD=shreeji_db_pass

# ==============================================================================
# CACHE / QUEUE / SESSION (Redis)
# ==============================================================================
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# MEILISEARCH (Full-text product search)
# ==============================================================================
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=shreeji_search_master_key_2024

# ==============================================================================
# MAIL (Mailpit for local dev, SMTP for production)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="sales@shreejiinfo.in"
MAIL_FROM_NAME="Shreeji Infotech"

# ==============================================================================
# RAZORPAY (Payment Gateway)
# ==============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==============================================================================
# PORTER (Ahmedabad Express Delivery — Phase 2)
# ==============================================================================
PORTER_API_KEY=
PORTER_BASE_URL=https://pfe-apigw-uat.porter.in
PORTER_WEBHOOK_URL=
PORTER_PICKUP_LAT=23.0069
PORTER_PICKUP_LNG=72.6069
PORTER_PICKUP_CONTACT="Shreeji Infotech"
PORTER_PICKUP_PHONE="+919377704344"

# ==============================================================================
# FILE STORAGE (Cloudflare R2 via S3-compatible API)
# ==============================================================================
FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=shreeji-assets
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================================================
# SHREEJI BUSINESS DETAILS
# ==============================================================================
SHREEJI_LEGAL_NAME="Shreeji Infotech"
SHREEJI_GSTIN=
SHREEJI_PAN=
SHREEJI_EMAIL=sales@shreejiinfo.in
SHREEJI_PHONE=+919377704344
SHREEJI_ADDRESS_LINE_1="Maninagar"
SHREEJI_ADDRESS_LINE_2=

# Bank details for invoices
SHREEJI_BANK_NAME=
SHREEJI_BANK_ACCOUNT=
SHREEJI_BANK_IFSC=
SHREEJI_BANK_BRANCH=

# ==============================================================================
# EXPRESS DELIVERY
# ==============================================================================
EXPRESS_DELIVERY_ENABLED=true

# ==============================================================================
# SANCTUM (API Authentication)
# ==============================================================================
SANCTUM_STATEFUL_DOMAINS=localhost:3000,shop.shreejiinfo.in
